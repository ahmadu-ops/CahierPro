<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="500.0" styleClass="form-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.chef.AjoutUtilisateurController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" styleClass="form-header" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="form-title" text="Ajouter un Utilisateur" />
         </children>
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="form-content" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Nom *" />
                  <TextField fx:id="nomField" prefHeight="40.0" promptText="Entrez le nom" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Prénom *" />
                  <TextField fx:id="prenomField" prefHeight="40.0" promptText="Entrez le prénom" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Email *" />
                  <TextField fx:id="emailField" prefHeight="40.0" promptText="Entrez l'email" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Mot de passe *" />
                  <PasswordField fx:id="motDePasseField" prefHeight="40.0" promptText="Entrez le mot de passe" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Confirmer le mot de passe *" />
                  <PasswordField fx:id="confirmMotDePasseField" prefHeight="40.0" promptText="Confirmez le mot de passe" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Rôle *" />
                  <ComboBox fx:id="roleComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Sélectionnez un rôle" styleClass="form-control" />
               </children>
            </VBox>
            <HBox fx:id="classeContainer" managed="false" spacing="10.0" styleClass="form-group" visible="false">
               <children>
                  <Label styleClass="form-label" text="Classe *" />
                  <ComboBox fx:id="classeComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Sélectionnez une classe" styleClass="form-control" />
               </children>
            </HBox>
            <VBox fx:id="nouvelleClasseContainer" managed="false" spacing="10.0" styleClass="form-group" visible="false">
               <children>
                  <Label styleClass="form-label" text="Nouvelle classe (si applicable)" />
                  <TextField fx:id="nouvelleClasseField" prefHeight="40.0" promptText="Entrez le nom de la nouvelle classe" styleClass="form-control" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="80.0" spacing="15.0" styleClass="form-footer" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" styleClass="button-secondary" text="Annuler" />
            <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSave" prefHeight="40.0" prefWidth="120.0" styleClass="button-primary" text="Enregistrer" />
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>