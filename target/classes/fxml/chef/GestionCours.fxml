<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox spacing="20.0" styleClass="container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.chef.GestionCoursController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <ComboBox fx:id="classeComboBox" prefHeight="40.0" prefWidth="250.0" promptText="Sélectionner une classe" />
            <Button fx:id="ajouterCoursButton" mnemonicParsing="false" onAction="#handleAjouterCours" prefHeight="40.0" styleClass="action-button" text="Ajouter un Cours">
               <graphic>
                  <SVGPath content="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" fill="WHITE" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="coursTableView" prefHeight="500.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="nomCoursColumn" prefWidth="200.0" text="Nom du cours" />
          <TableColumn fx:id="enseignantColumn" prefWidth="200.0" text="Enseignant" />
          <TableColumn fx:id="classeColumn" prefWidth="150.0" text="Classe" />
          <TableColumn fx:id="volumeHoraireColumn" prefWidth="150.0" text="Volume horaire" />
          <TableColumn fx:id="realisationColumn" prefWidth="150.0" text="Réalisation (%)" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>