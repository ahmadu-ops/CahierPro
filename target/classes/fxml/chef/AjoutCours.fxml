<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="500.0" styleClass="form-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.chef.AjoutCoursController">

   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="form-content" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Intitulé du cours *" />
                  <TextField fx:id="intituleField" prefHeight="40.0" promptText="Entrez l'intitulé du cours" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Volume horaire (en heures) *" />
                  <TextField fx:id="volumeHoraireField" prefHeight="40.0" promptText="Entrez le volume horaire" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Enseignant *" />
                  <ComboBox fx:id="enseignantComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Sélectionnez un enseignant" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Classe *" />
                  <ComboBox fx:id="classeComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Sélectionnez une classe" styleClass="form-control" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="80.0" spacing="15.0" styleClass="form-footer" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" styleClass="button-secondary" text="Annuler" />
            <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" onAction="#handleSave" prefHeight="40.0" prefWidth="120.0" styleClass="button-primary" text="Enregistrer" />
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>