<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="450.0" prefWidth="500.0" styleClass="form-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.chef.GenerationFicheController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" styleClass="form-header" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="form-title" text="Générer une Fiche Pédagogique" />
         </children>
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="form-content" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Classe *" />
                  <ComboBox fx:id="classeComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Sélectionnez une classe" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Cours *" />
                  <ComboBox fx:id="coursComboBox" prefHeight="40.0" prefWidth="400.0" promptText="Sélectionnez un cours" styleClass="form-control" />
               </children>
            </VBox>
            <VBox spacing="10.0" styleClass="form-group">
               <children>
                  <Label styleClass="form-label" text="Commentaire" />
                  <TextArea fx:id="commentaireTextArea" prefHeight="100.0" prefWidth="200.0" promptText="Ajouter un commentaire (facultatif)" styleClass="form-control" wrapText="true" />
               </children>
            </VBox>
            <VBox spacing="5.0" styleClass="form-group">
               <children>
                  <Label fx:id="pourcentageLabel" styleClass="form-info" text="Pourcentage de réalisation : --" />
                  <Label fx:id="enseignantLabel" styleClass="form-info" text="Enseignant : --" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="80.0" spacing="15.0" styleClass="form-footer" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" styleClass="button-secondary" text="Annuler" />
            <Button fx:id="generateButton" defaultButton="true" mnemonicParsing="false" onAction="#handleGenerate" prefHeight="40.0" prefWidth="120.0" styleClass="button-primary" text="Générer" />
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>