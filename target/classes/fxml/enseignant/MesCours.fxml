<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.enseignant.MesCoursController">
   <children>
      <Label styleClass="section-title" text="Liste de mes cours" />
      <TableView fx:id="coursTableView" prefHeight="500.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="nomCoursColumn" prefWidth="250.0" text="Nom du cours" />
          <TableColumn fx:id="classeColumn" prefWidth="200.0" text="Classe" />
          <TableColumn fx:id="volumeHoraireColumn" prefWidth="200.0" text="Volume horaire" />
          <TableColumn fx:id="realisationColumn" prefWidth="200.0" text="Réalisation (%)" />
          <TableColumn fx:id="actionsColumn" prefWidth="250.0" text="Actions" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>