<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.responsable.CahierTexteController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label styleClass="section-title" text="Cahier de Texte - Toutes les séances" />
            <ComboBox fx:id="coursComboBox" prefHeight="40.0" prefWidth="250.0" promptText="Filtrer par cours" />
         </children>
      </HBox>
      <TableView fx:id="seancesTableView" prefHeight="500.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
          <TableColumn fx:id="coursColumn" prefWidth="150.0" text="Cours" />
          <TableColumn fx:id="enseignantColumn" prefWidth="150.0" text="Enseignant" />
          <TableColumn fx:id="dureeColumn" prefWidth="80.0" text="Durée (min)" />
          <TableColumn fx:id="contenuColumn" prefWidth="200.0" text="Contenu" />
          <TableColumn fx:id="statutColumn" prefWidth="100.0" text="Statut" />
          <TableColumn fx:id="actionsColumn" prefWidth="120.0" text="Actions" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>