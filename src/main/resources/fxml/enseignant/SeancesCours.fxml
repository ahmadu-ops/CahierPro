<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="form-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.enseignant.SeancesCoursController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="15.0" styleClass="form-header" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="titreCoursLabel" styleClass="form-title" text="Séances du cours: [Nom du cours]" />
         </children>
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" styleClass="form-content" BorderPane.alignment="CENTER">
         <children>
            <GridPane hgap="20.0" vgap="10.0">
              <columnConstraints>
                <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
                <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="150.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="form-label" text="Classe" />
                        <Label fx:id="classeLabel" styleClass="form-value" text="--" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="1">
                     <children>
                        <Label styleClass="form-label" text="Volume horaire" />
                        <Label fx:id="volumeHoraireLabel" styleClass="form-value" text="--" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" GridPane.columnIndex="2">
                     <children>
                        <Label styleClass="form-label" text="Pourcentage de réalisation" />
                        <Label fx:id="pourcentageLabel" styleClass="form-value" text="--" />
                     </children>
                  </VBox>
               </children>
            </GridPane>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label styleClass="section-title" text="Liste des séances" />
                  <Button fx:id="ajouterSeanceButton" mnemonicParsing="false" onAction="#handleAjouterSeance" prefHeight="40.0" styleClass="action-button" text="Ajouter une Séance">
                     <graphic>
                        <SVGPath content="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" fill="WHITE" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="seancesTableView" prefHeight="350.0">
              <columns>
                <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date" />
                <TableColumn fx:id="dureeColumn" prefWidth="100.0" text="Durée (min)" />
                <TableColumn fx:id="contenuColumn" prefWidth="400.0" text="Contenu" />
                <TableColumn fx:id="statutColumn" prefWidth="100.0" text="Statut" />
              </columns>
            </TableView>
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="80.0" spacing="15.0" styleClass="form-footer" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleClose" prefHeight="40.0" prefWidth="120.0" styleClass="button-secondary" text="Fermer" />
         </children>
         <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>